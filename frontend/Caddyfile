{
  admin off
  auto_https off
}

:8080 {
  root * /srv
  encode zstd gzip

  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
  }

  @api path /api/v1 /api/v1/*
  @unsupportedApi path /api /api/*
  @immutableAsset {
    path_regexp ^/assets/.+-[A-Za-z0-9_-]{8,}\.[A-Za-z0-9]+$
    file {path}
  }

  route {
    handle /healthz {
      header Cache-Control no-store
      respond "ok" 200
    }

    handle @api {
      reverse_proxy {$API_UPSTREAM:http://api.railway.internal:8000}
    }

    handle @unsupportedApi {
      respond 404
    }

    handle /assets/* {
      header @immutableAsset Cache-Control "public, max-age=31536000, immutable" {
        match status 2xx 304
      }
      file_server
    }

    handle {
      header Cache-Control no-store
      try_files {path} /index.html
      file_server
    }
  }
}
