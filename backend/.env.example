# Скопіюйте файл у .env та вкажіть локальні значення поза Git.
APP_ENV=development
DATABASE_URL=<local-development-postgresql-async-url>
MFA_ENCRYPTION_KEYS=["<fernet-key-primary>"]
AUTH_THROTTLE_HMAC_KEY=<random-secret-at-least-32-characters>
PASSWORD_RESET_TOKEN_HMAC_KEYS=["<random-secret-at-least-32-characters>"]
INVITATION_TOKEN_HMAC_KEYS=["<random-secret-at-least-32-characters>"]
CORS_ALLOWED_ORIGINS=["https://localhost"]
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
STORAGE_BUCKET=<private-bucket-name>
STORAGE_ENDPOINT_URL=<private-s3-endpoint-url>
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=<storage-access-key>
STORAGE_SECRET_ACCESS_KEY=<storage-secret-key>
PUBLIC_APP_URL=https://localhost
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM_ADDRESS=Bacara Academy <academy@example.com>
WORKER_ID=horeca-worker-local
WORKER_IDLE_SECONDS=1
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
