# Скопіюйте файл у .env та вкажіть локальні значення поза Git.
APP_ENV=development
DATABASE_URL=<local-development-postgresql-async-url>
MFA_ENCRYPTION_KEYS=["<fernet-key-primary>"]
AUTH_THROTTLE_HMAC_KEY=<random-secret-at-least-32-characters>
CORS_ALLOWED_ORIGINS=["https://localhost"]
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
